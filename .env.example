# Brasilab Hub — configuração de ambiente (Sprint 03.2)
# Copie este arquivo para .env e ajuste os valores. O .env NÃO é versionado.

# --- Banco de dados (PostgreSQL — único banco suportado) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=brasilab

# URL completa usada pela aplicação em desenvolvimento local (npm run dev).
# No Docker Compose ela é montada automaticamente a partir das variáveis acima.
DATABASE_URL=postgres://postgres:troque-esta-senha@127.0.0.1:5432/brasilab

# --- Sessão ---
SESSION_TTL_HOURS=8
# true somente atrás de HTTPS (produção com proxy reverso e TLS)
COOKIE_SECURE=false

# --- Arquivos ---
# Diretório físico do storage (o banco guarda apenas o caminho relativo).
# Local (dev): pasta ./storage do projeto. No container: /app/storage.
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=10485760

# --- Aplicação ---
PORT=3000
